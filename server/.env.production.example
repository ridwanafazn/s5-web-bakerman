NODE_ENV=production
PORT=5050

# MongoDB Atlas Cloud (production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bakerman?retryWrites=true&w=majority

# Wajib origin eksplisit di production (jangan *).
CORS_ORIGIN=https://your-domain.example

FIREBASE_PROJECT_ID=your-firebase-project-id
# JSON service account (string) atau path file. Jangan commit.
FIREBASE_SERVICE_ACCOUNT=

ADMIN_EMAILS=admin@example.com
STAFF_EMAILS=staff@example.com

APP_TIMEZONE=Asia/Jakarta

# Opsional: DNS publik untuk SRV MongoDB Atlas.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Wajib 64 karakter hex di production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-domain.example/api/v1/strava/callback
STRAVA_DEMO_MODE=false

# Cloudinary — wajib untuk bukti screenshot aktivitas manual.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bakerman/manual-activities
CLOUDINARY_MOCK=false
MANUAL_ACTIVITY_SCREENSHOT_DAYS=7
MANUAL_ACTIVITY_MAX_MB=5

# Vercel Cron: Authorization Bearer <CRON_SECRET>
CRON_SECRET=

LOG_REQUESTS=true
TRUST_PROXY=1
