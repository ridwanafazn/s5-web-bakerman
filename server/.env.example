NODE_ENV=development
PORT=5050

# Development: MongoDB Atlas Local via docker compose
MONGODB_URI=mongodb://127.0.0.1:27017/bakerman?directConnection=true

# Production example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bakerman?retryWrites=true&w=majority

CORS_ORIGIN=http://localhost:5173

FIREBASE_PROJECT_ID=your-firebase-project-id
# Opsional: JSON service account atau path file.
# FIREBASE_SERVICE_ACCOUNT=./service-account.json

ADMIN_EMAILS=admin@example.com
STAFF_EMAILS=staff@example.com

APP_TIMEZONE=Asia/Jakarta

# Opsional: DNS publik untuk SRV MongoDB Atlas di jaringan lokal.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5050/api/v1/strava/callback
# Mode simulasi untuk demo lokal tanpa Strava app. Jangan aktifkan di production.
STRAVA_DEMO_MODE=false

# Cloudinary — bukti screenshot aktivitas manual.
# Buat akun gratis di https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bakerman/manual-activities
# true hanya untuk dev tanpa kredensial Cloudinary. Production wajib false.
CLOUDINARY_MOCK=false
MANUAL_ACTIVITY_SCREENSHOT_DAYS=7
MANUAL_ACTIVITY_MAX_MB=5

# Secret untuk cron cleanup Cloudinary (Vercel Cron / internal endpoint).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Production: aktifkan log request JSON dan percayai reverse proxy (nginx/Vercel).
# LOG_REQUESTS=true
# TRUST_PROXY=1
